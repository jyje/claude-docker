# Claude Code Environment Variables
# Copy this file to .env and fill in your values
# Usage: docker run --env-file .env ...

# ============================================
# Required: Anthropic API Key
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Optional: Custom API Base URL
# ============================================
# Use this for local models (e.g., Docker Model Runner) or custom endpoints
# Default: https://api.anthropic.com (if not set)

# For Docker Model Runner:
# ANTHROPIC_BASE_URL=http://localhost:12434

# For custom proxy:
# ANTHROPIC_BASE_URL=https://your-proxy.company.com/v1

# ============================================
# Optional: Authentication and endpoint
# ============================================
# See https://code.claude.com/docs/en/env-vars for the full reference

# Bearer token alternative to ANTHROPIC_API_KEY, common for gateways. Treat as a secret.
# ANTHROPIC_AUTH_TOKEN=

# Extra headers attached to every API request (one "Header: value" pair per line)
# ANTHROPIC_CUSTOM_HEADERS=

# Extra beta feature flags requested via the anthropic-beta header
# ANTHROPIC_BETAS=

# ============================================
# Optional: Model selection
# ============================================
# ANTHROPIC_MODEL=
# ANTHROPIC_DEFAULT_MODEL=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=

# ============================================
# Optional: Cloud providers
# ============================================
# CLAUDE_CODE_USE_BEDROCK=
# CLAUDE_CODE_USE_VERTEX=
# ANTHROPIC_VERTEX_PROJECT_ID=
# ANTHROPIC_BEDROCK_BASE_URL=
# ANTHROPIC_VERTEX_BASE_URL=

# ============================================
# Optional: Network, proxy, and gateway compatibility
# ============================================
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
# API_TIMEOUT_MS=

# Strips beta headers/tool-schema fields for gateways that reject anthropic-beta requests.
# Also disables MCP tool search and loads all MCP tools upfront.
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=

# ============================================
# Optional: Execution limits and token budgets
# ============================================
# BASH_DEFAULT_TIMEOUT_MS=
# BASH_MAX_TIMEOUT_MS=
# BASH_MAX_OUTPUT_LENGTH=
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=
# MAX_THINKING_TOKENS=
# MCP_TIMEOUT=
# MAX_MCP_OUTPUT_TOKENS=

# ============================================
# Optional: Container operations, updates, and privacy
# ============================================
# Overrides the config directory (default ~/.claude). This is the directory the
# README's MCP section mounts as the claude-mcp-config volume.
# CLAUDE_CONFIG_DIR=

# Disables the background auto-update check. Matters here because this image
# ships pinned Claude Code versions.
# DISABLE_AUTOUPDATER=

# Stricter than DISABLE_AUTOUPDATER: also blocks manual `claude update`/`claude install`.
# DISABLE_UPDATES=

# Any non-empty value opts out, including 0 or false. Unset to re-enable.
# Also disables feature-flag fetching (e.g. Remote Control).
# DISABLE_TELEMETRY=

# Cross-tool convention. Unlike DISABLE_TELEMETRY, this is a normal boolean:
# DO_NOT_TRACK=0 leaves telemetry on, DO_NOT_TRACK=1 turns it off.
# DO_NOT_TRACK=

# Same "any non-empty value opts out" semantics as DISABLE_TELEMETRY.
# DISABLE_ERROR_REPORTING=

# ============================================
# Optional: MCP Server Environment Variables
# ============================================
# These are used when connecting to MCP servers that require authentication

# Database connection (for PostgreSQL MCP server)
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# GitHub Personal Access Token (if not using OAuth)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Other service API keys
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
