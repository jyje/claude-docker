# Claude Code Environment Variables
# Copy this file to .env and fill in your values
# Usage: docker run --env-file .env ...

# ============================================
# Required: Anthropic API Key
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Optional: Custom API Base URL
# ============================================
# Use this for local models (e.g., Docker Model Runner) or custom endpoints
# Default: https://api.anthropic.com (if not set)

# For Docker Model Runner:
# ANTHROPIC_BASE_URL=http://localhost:12434

# For custom proxy:
# ANTHROPIC_BASE_URL=https://your-proxy.company.com/v1

# ============================================
# Optional: Model Selection
# ============================================
# ANTHROPIC_MODEL=
# ANTHROPIC_DEFAULT_MODEL=
# ANTHROPIC_DEFAULT_OPUS_MODEL=
# ANTHROPIC_DEFAULT_SONNET_MODEL=
# ANTHROPIC_DEFAULT_HAIKU_MODEL=

# ============================================
# Optional: Cloud Providers
# ============================================
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=my-gcp-project
# ANTHROPIC_BEDROCK_BASE_URL=
# ANTHROPIC_VERTEX_BASE_URL=

# ============================================
# Optional: Network, Proxy & Gateway
# ============================================
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal

# API request timeout (default: 600000 = 10 minutes)
# API_TIMEOUT_MS=600000

# Custom auth header, prefixed with "Bearer " automatically.
# Treat as a secret, same as ANTHROPIC_API_KEY.
# ANTHROPIC_AUTH_TOKEN=

# Extra request headers, "Name: Value" format
# ANTHROPIC_CUSTOM_HEADERS=

# Opt into an API beta early (comma-separated)
# ANTHROPIC_BETAS=

# Strip anthropic-beta headers when a gateway rejects them.
# Also disables MCP tool search.
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# ============================================
# Optional: Execution Limits & Token Budgets
# ============================================
# Worth tuning for non-interactive CI runs (claude -p)
# BASH_DEFAULT_TIMEOUT_MS=120000
# BASH_MAX_TIMEOUT_MS=600000
# BASH_MAX_OUTPUT_LENGTH=30000
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=
# MAX_THINKING_TOKENS=
# MCP_TIMEOUT=30000
# MAX_MCP_OUTPUT_TOKENS=

# ============================================
# Optional: Container Operations, Updates & Privacy
# ============================================
# Config directory. Settings, session history and plugins live here,
# so point your volume mount at this path.
# CLAUDE_CONFIG_DIR=/home/node/.claude

# Disable background auto-update (manual `claude update` still works)
# DISABLE_AUTOUPDATER=1

# Block ALL updates including manual ones. Recommended for pinned images.
# DISABLE_UPDATES=1

# WARNING: DISABLE_TELEMETRY and DISABLE_ERROR_REPORTING opt out on ANY
# non-empty value, including "0" and "false". Setting them to 0 does NOT
# re-enable. To re-enable, comment the line out / leave them unset.
# DISABLE_TELEMETRY=1
# DISABLE_ERROR_REPORTING=1

# DO_NOT_TRACK is the exception: a normal boolean, so 0 leaves telemetry ON.
# DO_NOT_TRACK=1

# ============================================
# Optional: MCP Server Environment Variables
# ============================================
# These are used when connecting to MCP servers that require authentication

# Database connection (for PostgreSQL MCP server)
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# GitHub Personal Access Token (if not using OAuth)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Other service API keys
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
